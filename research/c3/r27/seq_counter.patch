+def seq_counter(xs, kmax):
+    """Unary sequential counter (Sinz style, one-directional x -> count). Returns (clauses, outs) where outs[j] is a literal
+    that is forced TRUE whenever at least j of xs are true (j = 1..kmax+1). Asserting Not(outs[k+1]) means 'at most k'."""
+    cl = []; prev = [BoolVal(False)] * (kmax + 2)
+    for i, x in enumerate(xs):
+        cur = [BoolVal(False)] * (kmax + 2)
+        for j in range(1, kmax + 2):
+            c = Bool(f'cnt_{i}_{j}')
+            cl.append(Implies(prev[j], c))
+            cl.append(Implies(And(x, prev[j - 1]) if j > 1 else x, c))
+            cur[j] = c
+        prev = cur
+    return cl, prev
+
+
